#!/usr/bin/env bash
# Block direct pushes to main. Promote via PR: dev → main.
# Enable once per clone: git config core.hooksPath .githooks

set -euo pipefail

remote="${1:-}"
url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "Direct pushes to main are blocked."
    echo "Open a PR from dev → main instead (see plans/coherent-v1/release-and-deploy.md)."
    exit 1
  fi
done

exit 0
