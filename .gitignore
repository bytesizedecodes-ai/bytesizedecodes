# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production (root only — do not ignore app/build routes)
/build
dist

# misc
.DS_Store
*.pem
.tmpcfg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
