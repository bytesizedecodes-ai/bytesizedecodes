# =============================================================================
# ByteSizeDecodes — environment template (copy to .env.local and fill in)
# =============================================================================
# Next.js reads NEXT_PUBLIC_* at build/dev time.
# OAuth client secrets for Convex Auth belong on the **Convex deployment**
# (Dashboard → Settings → Environment Variables, or `npx convex env set`).
# =============================================================================

# --- Convex (required for app data) ---
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Google OAuth (social sign-in) ---
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# 2. Authorized redirect URI (Convex Auth site URL), typically:
#    https://<your-deployment>.convex.site/api/auth/callback/google
# 3. Set the same Client ID + Secret on Convex:
#    npx convex env set AUTH_GOOGLE_ID "...."
#    npx convex env set AUTH_GOOGLE_SECRET "...."
# 4. Enable the button in Next:
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_ID=          # set on Convex, not required in Next if only used server-side there
# AUTH_GOOGLE_SECRET=

# --- GitHub OAuth (social sign-in — prepared; set enabled when ready) ---
# 1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# 2. Homepage URL: your site origin (e.g. http://localhost:3000 or https://bytesizedecodes.com)
# 3. Authorization callback URL (must match Convex Auth):
#    https://<your-deployment>.convex.site/api/auth/callback/github
# 4. Copy Client ID + generate Client secret
# 5. On Convex deployment:
#    npx convex env set AUTH_GITHUB_ID "Iv1...."
#    npx convex env set AUTH_GITHUB_SECRET "...."
# 6. Flip the UI flag:
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Optional: site JWT / Convex Auth JWT_PRIVATE_KEY etc. are managed by `npx @convex-dev/auth`

# --- Admin console ---
# Operator allowlist (Convex env, comma-separated):
#    npx convex env set ADMIN_EMAILS "you@example.com"
# Outbound /admin email (Resend — Convex env only):
#    npx convex env set RESEND_API_KEY "re_...."
#    npx convex env set EMAIL_FROM "ByteSizeDecodes <hello@yourdomain.com>"
